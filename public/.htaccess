# Release-aware cache policy for the static Ryadom application.
# The browser must revalidate the HTML entry point; version.json is polled
# by clients already open. Vite emits fingerprinted JS/CSS assets.
<IfModule mod_setenvif.c>
  <Files "friends.php">
    SetEnvIfNoCase Authorization "^(.+)$" HTTP_AUTHORIZATION=$1
  </Files>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|version\.json)$">
    Header always set Cache-Control "no-store, max-age=0, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
