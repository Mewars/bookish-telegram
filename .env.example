VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable only after configuring and verifying the custom:vk server provider.
# See docs/vk-id.md. This flag alone does not connect VK ID.
VITE_VK_ID_ENABLED=false

# Enable only after manually installing/reviewing the SQL and verifying HTTPS.
VITE_ORGANIZATIONS_ENABLED=false
